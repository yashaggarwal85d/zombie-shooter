class_name ToyAudio
extends Node2D
## Placeholder sounds (generated by tools/art_src/make_toy_sounds.py). World
## sounds are positional, so you hear which side a hit came from. The hum
## loops and fades with the shelter's integrity.

const SOUNDS: Dictionary[StringName, String] = {
	&"shot_loud": "res://assets/audio/toy/shot_loud.wav",
	&"shot_quiet": "res://assets/audio/toy/shot_quiet.wav",
	&"melee": "res://assets/audio/toy/melee.wav",
	&"flesh": "res://assets/audio/toy/flesh.wav",
	&"growl": "res://assets/audio/toy/growl.wav",
	&"knock": "res://assets/audio/toy/knock.wav",
	&"crash": "res://assets/audio/toy/crash.wav",
	&"shelter_hit": "res://assets/audio/toy/shelter_hit.wav",
	&"hurt": "res://assets/audio/toy/hurt.wav",
	&"build": "res://assets/audio/toy/build.wav",
	&"dawn": "res://assets/audio/toy/dawn.wav",
	&"sting": "res://assets/audio/toy/sting.wav",
}
const HUM: String = "res://assets/audio/toy/hum.wav"
const POOL: int = 16

var _streams: Dictionary[StringName, AudioStream] = {}
var _pool: Array[AudioStreamPlayer2D] = []
var _next: int = 0
var _hum: AudioStreamPlayer2D
var _ui: AudioStreamPlayer


func _ready() -> void:
	for key: StringName in SOUNDS:
		_streams[key] = load(SOUNDS[key]) as AudioStream
	for i: int in POOL:
		var p: AudioStreamPlayer2D = AudioStreamPlayer2D.new()
		p.max_distance = 4000.0
		p.attenuation = 0.6
		add_child(p)
		_pool.append(p)
	_ui = AudioStreamPlayer.new()
	add_child(_ui)
	var hum_stream: AudioStreamWAV = (load(HUM) as AudioStreamWAV).duplicate() as AudioStreamWAV
	hum_stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	hum_stream.loop_begin = 0
	hum_stream.loop_end = hum_stream.data.size() / 2
	_hum = AudioStreamPlayer2D.new()
	_hum.stream = hum_stream
	_hum.max_distance = 6000.0
	_hum.attenuation = 0.4
	_hum.position = Vector2(FieldSim.SHELTER_X, -60.0)
	_hum.volume_db = -14.0
	add_child(_hum)


func play_at(key: StringName, field_pos: Vector2, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var p: AudioStreamPlayer2D = _pool[_next]
	_next = (_next + 1) % POOL
	p.stream = _streams[key]
	p.position = Vector2(field_pos.x, -field_pos.y)
	p.volume_db = volume_db
	p.pitch_scale = pitch * randf_range(0.94, 1.06)
	p.play()


func play_ui(key: StringName, volume_db: float = 0.0) -> void:
	_ui.stream = _streams[key]
	_ui.volume_db = volume_db
	_ui.play()


func set_hum(on: bool, integrity: float) -> void:
	if on and not _hum.playing:
		_hum.play()
	elif not on and _hum.playing:
		_hum.stop()
	_hum.volume_db = lerpf(-30.0, -12.0, clampf(integrity, 0.0, 1.0))
